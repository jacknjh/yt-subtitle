{
  "manifestVersion": 5,
  "id": "local.ytsubtitle.reader",
  "name": "Subtitle Generator Reader",
  "version": "0.1.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.2.2", "data": { "loadEvent": "startup" } },
  "entrypoints": [{
    "type": "panel",
    "id": "subtitleProbe",
    "label": { "default": "Reader status" },
    "minimumSize": { "width": 280, "height": 360 },
    "preferredDockedSize": { "width": 360, "height": 560 },
    "preferredFloatingSize": { "width": 440, "height": 600 }
  }],
  "requiredPermissions": { "localFileSystem": "request" }
}
