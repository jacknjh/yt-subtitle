{
  "manifestVersion": 5,
  "id": "yt-subtitle-compatibility",
  "name": "Subtitle Compatibility",
  "version": "0.0.1",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "26.2.2" },
  "entrypoints": [{
    "type": "panel",
    "id": "subtitleProbe",
    "label": { "default": "Subtitle Compatibility" },
    "minimumSize": { "width": 280, "height": 360 },
    "preferredDockedSize": { "width": 360, "height": 560 },
    "preferredFloatingSize": { "width": 440, "height": 600 }
  }],
  "requiredPermissions": { "localFileSystem": "request" }
}
